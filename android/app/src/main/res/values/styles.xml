<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark from the very first frame: the window background IS the splash (black + door). -->
    <style name="Phantom" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="android:statusBarColor">@color/realm_black</item>
        <item name="android:navigationBarColor">@color/realm_black</item>
        <item name="android:colorAccent">@color/realm_crimson</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
