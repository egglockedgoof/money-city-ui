{
  "appId": "com.phantomway.app",
  "appName": "PhantomWay",
  "webDir": "www",
  "backgroundColor": "#0a0a0a",
  "ios": {
    "contentInset": "never",
    "scrollEnabled": false,
    "allowsLinkPreview": false,
    "backgroundColor": "#0a0a0a"
  },
  "plugins": {
    "Keyboard": { "resize": "native", "style": "DARK", "resizeOnFullScreen": true },
    "StatusBar": { "style": "DARK", "backgroundColor": "#0a0a0a" },
    "SplashScreen": { "launchShowDuration": 700, "launchAutoHide": true, "backgroundColor": "#0a0a0a", "showSpinner": false }
  }
}
